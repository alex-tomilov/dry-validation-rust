#!/usr/bin/env bash
set -euo pipefail

project_root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
command_name="${1:-demo}"

if (( $# > 0 )); then
  shift
fi

usage() {
  cat <<'USAGE'
Usage: dvr [command]

Commands:
  demo [--json]  Run the deterministic validation demo (default).
  test           Run the packaged, precompiled runtime smoke suite.
  doctor         Print runtime and native-extension diagnostics.
  benchmark      Run the configurable, non-gating benchmark.
  help           Print this help.
USAGE
}

benchmark_usage() {
  cat <<'USAGE'
Usage: dvr benchmark [options]

Options:
  --iterations N  Measured calls per engine (default: 1000).
  --warmup N      Warmup calls per engine (default: 100).
  --engine NAME   rust, upstream, or compare (default: rust).
  --format NAME   json or text (default: json).
  -h, --help      Print this help.
USAGE
}

require_no_arguments() {
  if (( $# != 0 )); then
    printf '%s does not accept arguments\n' "$command_name" >&2
    exit 64
  fi
}

case "$command_name" in
  demo)
    exec ruby -I"$project_root/lib" "$project_root/script/demo" "$@"
    ;;
  test)
    require_no_arguments "$@"
    ruby -I"$project_root/lib" -e '
      require "rbconfig"
      require "dry/validation/rust"

      extension_name = "native.#{RbConfig::CONFIG.fetch("DLEXT")}"
      expected = File.realpath(File.join(ARGV.fetch(0), "ext/dry_validation_rust", extension_name))
      loaded = $LOADED_FEATURES.find do |path|
        File.basename(path) == extension_name && File.basename(File.dirname(path)) == "dry_validation_rust"
      end
      abort "native extension was not loaded" unless loaded
      abort "loaded native extension from #{loaded}, expected #{expected}" unless File.realpath(loaded) == expected

      puts "native_extension=#{expected}"
    ' "$project_root"
    exec ruby -I"$project_root/lib" "$project_root/script/demo" --json
    ;;
  doctor)
    require_no_arguments "$@"
    exec ruby -I"$project_root/lib" -e '
      require "rbconfig"
      require "dry/validation/rust"

      extension_name = "native.#{RbConfig::CONFIG.fetch("DLEXT")}"
      extension = $LOADED_FEATURES.find do |path|
        File.basename(path) == extension_name && File.basename(File.dirname(path)) == "dry_validation_rust"
      end
      abort "native extension was not loaded" unless extension

      puts "ruby=#{RUBY_DESCRIPTION}"
      puts "platform=#{RUBY_PLATFORM}"
      puts "gem_version=#{Dry::Validation::Rust::VERSION}"
      puts "native_extension=#{File.realpath(extension)}"
      puts "native_extension_loaded=true"
      puts "runtime_uid=#{Process.uid}"
      puts "image_revision=#{ENV.fetch("DVR_IMAGE_REVISION", "").then { |value| value.empty? ? "unlabeled" : value }}"
      support_status = if RUBY_PLATFORM == "x86_64-linux"
        "verified Linux x86_64 judge image"
      else
        "unverified image platform #{RUBY_PLATFORM}; supported judge image is Linux x86_64 with glibc"
      end
      puts "support_status=#{support_status}"
      puts "openai_api_key_required=false"
    '
    ;;
  benchmark)
    iterations=1000
    warmup=100
    engine=rust
    format=json

    while (( $# > 0 )); do
      case "$1" in
        --iterations)
          [[ $# -ge 2 ]] || { printf '%s\n' '--iterations requires a value' >&2; exit 64; }
          iterations="$2"
          shift 2
          ;;
        --warmup)
          [[ $# -ge 2 ]] || { printf '%s\n' '--warmup requires a value' >&2; exit 64; }
          warmup="$2"
          shift 2
          ;;
        --engine)
          [[ $# -ge 2 ]] || { printf '%s\n' '--engine requires a value' >&2; exit 64; }
          engine="$2"
          shift 2
          ;;
        --format)
          [[ $# -ge 2 ]] || { printf '%s\n' '--format requires a value' >&2; exit 64; }
          format="$2"
          shift 2
          ;;
        -h|--help)
          benchmark_usage
          exit 0
          ;;
        *)
          printf 'Unknown benchmark option: %s\n\n' "$1" >&2
          benchmark_usage >&2
          exit 64
          ;;
      esac
    done

    [[ "$iterations" =~ ^[1-9][0-9]*$ ]] || { printf '%s\n' '--iterations must be a positive integer' >&2; exit 64; }
    [[ "$warmup" =~ ^(0|[1-9][0-9]*)$ ]] || { printf '%s\n' '--warmup must be a non-negative integer' >&2; exit 64; }
    [[ "$engine" =~ ^(rust|upstream|compare)$ ]] || { printf '%s\n' '--engine must be rust, upstream, or compare' >&2; exit 64; }
    [[ "$format" =~ ^(json|text)$ ]] || { printf '%s\n' '--format must be json or text' >&2; exit 64; }

    upstream_gem_home="${DVR_UPSTREAM_GEM_HOME:-/opt/upstream-gems}"
    if [[ -d "$upstream_gem_home" ]]; then
      export GEM_PATH="${upstream_gem_home}${GEM_PATH:+:${GEM_PATH}}"
    fi

    export N="$iterations" WARMUP="$warmup" ENGINE="$engine" FORMAT="$format"
    printf '%s\n' 'Synthetic single-schema benchmark; repeat runs and do not present it as a universal performance claim.' >&2
    exec "$project_root/script/benchmark-smoke"
    ;;
  help|-h|--help)
    require_no_arguments "$@"
    usage
    ;;
  *)
    printf 'Unknown command: %s\n\n' "$command_name" >&2
    usage >&2
    exit 64
    ;;
esac
