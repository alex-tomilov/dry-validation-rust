#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

run() {
  printf "\n==> %s\n" "$*"
  "$@"
}

audit_rust_dependencies() {
  if ! command -v cargo-audit >/dev/null 2>&1; then
    if ! run cargo install cargo-audit --version 0.22.1 --locked; then
      printf "\nWARNING: cargo-audit could not be installed; continuing because Rust advisories are non-gating until actionable.\n" >&2
      return
    fi
  fi

  if ! (cd ext/dry_validation_rust && run cargo audit); then
    printf "\nWARNING: cargo audit failed; continuing because Rust advisories are non-gating until actionable.\n" >&2
  fi
}

RUBY_EXECUTABLE="$(ruby -rrbconfig -e 'print RbConfig.ruby')"
RUBY_LIBRARY_DIRECTORY="$(ruby -rrbconfig -e 'print RbConfig::CONFIG.fetch(%q[libdir])')"
export BINDGEN_EXTRA_CLANG_ARGS='-include stdbool.h'
export RUBY="$RUBY_EXECUTABLE"
export LD_LIBRARY_PATH="${RUBY_LIBRARY_DIRECTORY}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"

run bundle exec rake compile
run cargo fmt --check --manifest-path ext/dry_validation_rust/Cargo.toml
run cargo test --locked --manifest-path ext/dry_validation_rust/Cargo.toml
run cargo clippy --manifest-path ext/dry_validation_rust/Cargo.toml --all-targets --all-features -- -D warnings
audit_rust_dependencies
run cargo check --manifest-path ext/dry_validation_rust/Cargo.toml --locked
run bundle exec rake test
run bundle exec rake dependency:versions
run bundle exec rake package:audit
