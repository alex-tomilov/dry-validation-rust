#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../benchmark/support/suite"

begin
  configuration = DryValidationRustBenchmark::Configuration.parse(ARGV)
  summary = DryValidationRustBenchmark::Suite.new(configuration).call
  puts JSON.generate(
    "status" => "ok",
    "mode" => summary.fetch("mode"),
    "authoritative" => summary.fetch("authoritative"),
    "output" => configuration.output,
    "groups" => summary.fetch("groups").length
  )
rescue DryValidationRustBenchmark::Error => error
  warn "benchmark suite: #{error.message}"
  exit 64
end
