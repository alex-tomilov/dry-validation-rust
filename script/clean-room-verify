#!/usr/bin/env bash
set -euo pipefail

project_root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
mode="all"
mode_explicit=0
image_reference=""
output_directory=""
platform="linux/amd64"

usage() {
  cat <<'USAGE'
Usage: script/clean-room-verify [MODE] [OPTIONS]

Modes (choose one; default: --all):
  --docker-only   No-cache local image build and offline runtime smoke
  --native-only   Isolated bundle install, native compile, tests, and demo
  --package-only  Source-gem build, isolated install, and contract smoke
  --all           Run Docker, native, and package checks

Options:
  --image REFERENCE   Also anonymously pull and smoke-test a public image
  --output DIRECTORY  New tmp/ directory for redacted logs and summaries
  -h, --help          Show this help

The default output is an ignored tmp/clean-room directory. Existing output
directories are never overwritten. The script does not install host packages,
elevate privileges, print the full environment, or write credentials.
USAGE
}

select_mode() {
  if [[ "$mode_explicit" == 1 ]]; then
    printf '%s\n' 'Choose exactly one of --docker-only, --native-only, --package-only, or --all.' >&2
    exit 64
  fi

  mode="$1"
  mode_explicit=1
}

while (( $# > 0 )); do
  case "$1" in
    --docker-only)
      select_mode "docker"
      shift
      ;;
    --native-only)
      select_mode "native"
      shift
      ;;
    --package-only)
      select_mode "package"
      shift
      ;;
    --all)
      select_mode "all"
      shift
      ;;
    --image)
      [[ $# -ge 2 ]] || { printf '%s\n' '--image requires a value.' >&2; exit 64; }
      image_reference="$2"
      shift 2
      ;;
    --output)
      [[ $# -ge 2 ]] || { printf '%s\n' '--output requires a value.' >&2; exit 64; }
      output_directory="$2"
      shift 2
      ;;
    help|-h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'Unknown option: %s\n' "$1" >&2
      usage >&2
      exit 64
      ;;
  esac
done

if [[ -n "$image_reference" && "$mode" != "docker" && "$mode" != "all" ]]; then
  printf '%s\n' '--image is valid only with --docker-only or --all.' >&2
  exit 64
fi

if [[ "$image_reference" == *[[:space:]]* ]]; then
  printf '%s\n' '--image must not contain whitespace.' >&2
  exit 64
fi

if [[ -z "$output_directory" ]]; then
  output_directory="tmp/clean-room/$(date -u +%Y%m%dT%H%M%SZ)-$$"
fi

case "$output_directory" in
  tmp/*)
    if [[ ! "$output_directory" =~ ^tmp/[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$ ||
          "$output_directory" == *"/../"* || "$output_directory" == */.. ||
          "$output_directory" == *"/./"* || "$output_directory" == */. ]]; then
      printf '%s\n' '--output must stay under the repository tmp/ directory.' >&2
      exit 64
    fi
    output_path="$project_root/$output_directory"
    ;;
  *)
    printf '%s\n' '--output must be a relative path under the ignored tmp/ directory.' >&2
    exit 64
    ;;
esac

output_cursor="$project_root"
IFS='/' read -r -a output_components <<< "$output_directory"
for output_component in "${output_components[@]}"; do
  output_cursor="$output_cursor/$output_component"
  if [[ -L "$output_cursor" ]]; then
    printf 'Refusing a symlinked output path component: %s\n' "$output_cursor" >&2
    exit 73
  fi
done

if [[ -e "$output_path" || -L "$output_path" ]]; then
  printf 'Refusing to overwrite existing output: %s\n' "$output_path" >&2
  exit 73
fi

mkdir -p "$output_path/logs"
summary_tsv="$output_path/summary.tsv"
summary_markdown="$output_path/summary.md"
environment_file="$output_path/environment.txt"

printf 'check\tstatus\tdetail\tevidence\n' > "$summary_tsv"
cat > "$summary_markdown" <<'MARKDOWN'
# Clean-room verification summary

| Check | Status | Detail | Evidence |
| --- | --- | --- | --- |
MARKDOWN

user_home_path="${HOME:-}"

redact_stream() {
  DVR_REDACT_PROJECT_ROOT="$project_root" DVR_REDACT_HOME="$user_home_path" awk '
    function replace_fixed(value, needle, replacement, position) {
      if (needle == "") {
        return value
      }
      while ((position = index(value, needle)) != 0) {
        value = substr(value, 1, position - 1) replacement substr(value, position + length(needle))
      }
      return value
    }
    {
      output = replace_fixed($0, ENVIRON["DVR_REDACT_PROJECT_ROOT"], "<PROJECT_ROOT>")
      output = replace_fixed(output, ENVIRON["DVR_REDACT_HOME"], "<HOME>")
      print output
    }
  ' | sed -E \
    -e 's/github_pat_[A-Za-z0-9_]+/<REDACTED_TOKEN>/g' \
    -e 's/gh[pousr]_[A-Za-z0-9_]{20,}/<REDACTED_TOKEN>/g' \
    -e 's/sk-[A-Za-z0-9_-]{20,}/<REDACTED_TOKEN>/g' \
    -e 's/([A-Za-z0-9_]*([Tt][Oo][Kk][Ee][Nn]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|API_KEY)[A-Za-z0-9_]*=)[^[:space:]]+/\1<REDACTED>/g'
}

markdown_escape() {
  printf '%s' "$1" | sed 's/|/\\|/g'
}

failures=0
passes=0
skips=0

record_result() {
  check_name="$1"
  check_status="$2"
  check_detail="$3"
  check_evidence="$4"

  check_detail="$(printf '%s' "$check_detail" | tr '\t\r\n' '   ')"
  printf '%s\t%s\t%s\t%s\n' "$check_name" "$check_status" "$check_detail" "$check_evidence" >> "$summary_tsv"
  printf '| %s | %s | %s | `%s` |\n' \
    "$(markdown_escape "$check_name")" \
    "$(markdown_escape "$check_status")" \
    "$(markdown_escape "$check_detail")" \
    "$(markdown_escape "$check_evidence")" >> "$summary_markdown"
  printf '%-28s %-7s %s\n' "$check_name" "$check_status" "$check_detail"

  case "$check_status" in
    PASSED) passes=$((passes + 1)) ;;
    FAILED) failures=$((failures + 1)) ;;
    SKIPPED) skips=$((skips + 1)) ;;
  esac
}

run_logged() {
  log_name="$1"
  shift
  log_path="$output_path/logs/$log_name.log"

  {
    printf 'check=%s\ncommand=' "$log_name"
    printf ' %q' "$@"
    printf '\n'
  } | redact_stream | tee "$log_path"

  set +e
  "$@" 2>&1 | redact_stream | tee -a "$log_path"
  command_status=${PIPESTATUS[0]}
  set -e
  printf 'exit_status=%s\n' "$command_status" | tee -a "$log_path"
  return "$command_status"
}

write_environment_record() {
  {
    printf 'date_utc=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if command -v git >/dev/null 2>&1 && git -C "$project_root" rev-parse --verify HEAD >/dev/null 2>&1; then
      printf 'commit=%s\n' "$(git -C "$project_root" rev-parse HEAD)"
      if [[ -n "$(git -C "$project_root" status --porcelain --untracked-files=normal)" ]]; then
        printf 'working_tree=dirty\n'
      else
        printf 'working_tree=clean\n'
      fi
    else
      printf 'commit=unavailable\nworking_tree=unavailable\n'
    fi
    printf 'os=%s\n' "$(uname -srm)"
    printf 'mode=%s\n' "$mode"
    printf 'platform=%s\n' "$platform"
    [[ -z "$image_reference" ]] || printf 'public_image=%s\n' "$image_reference"
    command -v ruby >/dev/null 2>&1 && printf 'ruby=%s\n' "$(ruby --version 2>&1)"
    command -v bundle >/dev/null 2>&1 && printf 'bundler=%s\n' "$(bundle --version 2>&1)"
    command -v rustc >/dev/null 2>&1 && printf 'rust=%s\n' "$(rustc --version 2>&1)"
    command -v cargo >/dev/null 2>&1 && printf 'cargo=%s\n' "$(cargo --version 2>&1)"
    if command -v docker >/dev/null 2>&1; then
      docker version --format 'docker_client={{.Client.Version}} docker_server={{.Server.Version}}' 2>&1 || true
    fi
  } | redact_stream > "$environment_file"
}

write_environment_record

docker_config_path=""
local_image_tag=""

cleanup() {
  if [[ -n "$local_image_tag" ]] && command -v docker >/dev/null 2>&1; then
    env DOCKER_CONFIG="$docker_config_path" docker image rm --force "$local_image_tag" >/dev/null 2>&1 || true
  fi
  if [[ -n "$docker_config_path" && -d "$docker_config_path" ]]; then
    rm -rf -- "$docker_config_path"
  fi
}
trap cleanup EXIT INT TERM

run_docker_checks() {
  if ! command -v docker >/dev/null 2>&1; then
    record_result "local_docker" "SKIPPED" "Docker CLI is unavailable" "-"
    if [[ -n "$image_reference" ]]; then
      record_result "public_image" "SKIPPED" "Docker CLI is unavailable" "-"
    else
      record_result "public_image" "SKIPPED" "No public image reference supplied" "-"
    fi
    return
  fi

  if ! command -v mktemp >/dev/null 2>&1; then
    record_result "local_docker" "SKIPPED" "mktemp is unavailable for an isolated Docker config" "-"
    record_result "public_image" "SKIPPED" "mktemp is unavailable for an isolated Docker config" "-"
    return
  fi

  docker_config_path="$(mktemp -d "${TMPDIR:-/tmp}/dvr-clean-room-docker.XXXXXX")"

  if ! run_logged "docker_prerequisite" env DOCKER_CONFIG="$docker_config_path" docker info \
    --format 'server={{.ServerVersion}} os={{.OperatingSystem}} arch={{.Architecture}}'; then
    record_result "local_docker" "SKIPPED" "Docker daemon is unavailable; see prerequisite log" "logs/docker_prerequisite.log"
    if [[ -n "$image_reference" ]]; then
      record_result "public_image" "SKIPPED" "Docker daemon is unavailable; see prerequisite log" "logs/docker_prerequisite.log"
    else
      record_result "public_image" "SKIPPED" "No public image reference supplied" "-"
    fi
    return
  fi

  if [[ -n "$image_reference" ]]; then
    if run_logged "public_image_pull" env DOCKER_CONFIG="$docker_config_path" docker pull --platform "$platform" "$image_reference"; then
      digest="$(env DOCKER_CONFIG="$docker_config_path" docker image inspect --format '{{index .RepoDigests 0}}' "$image_reference" 2>/dev/null || true)"
      if [[ "$digest" =~ @sha256:[0-9a-f]{64}$ ]]; then
        printf 'repo_digest=%s\n' "$digest" | redact_stream >> "$output_path/logs/public_image_pull.log"
        record_result "public_image_pull" "PASSED" "Anonymous pull resolved $digest" "logs/public_image_pull.log"
        if run_logged "public_image_runtime" env DOCKER_CONFIG="$docker_config_path" \
          "$project_root/script/docker-smoke" --skip-build --tag "$digest" --platform "$platform"; then
          record_result "public_image_runtime" "PASSED" "Default, JSON, doctor, test, benchmark, and offline checks passed" "logs/public_image_runtime.log"
        else
          record_result "public_image_runtime" "FAILED" "Pulled image failed runtime smoke" "logs/public_image_runtime.log"
        fi
      else
        record_result "public_image_pull" "FAILED" "Pull succeeded but no immutable RepoDigest was recorded" "logs/public_image_pull.log"
      fi
    else
      record_result "public_image_pull" "FAILED" "Anonymous pull failed" "logs/public_image_pull.log"
    fi
  else
    record_result "public_image" "SKIPPED" "No public image reference supplied" "-"
  fi

  revision="unavailable"
  if command -v git >/dev/null 2>&1 && git -C "$project_root" rev-parse --verify HEAD >/dev/null 2>&1; then
    revision="$(git -C "$project_root" rev-parse HEAD)"
    if [[ -n "$(git -C "$project_root" status --porcelain --untracked-files=normal)" ]]; then
      revision="${revision}-dirty"
    fi
  fi

  local_image_tag="dry-validation-rust:clean-room-$$"
  if run_logged "local_docker_build" env DOCKER_CONFIG="$docker_config_path" docker build \
    --no-cache --pull --platform "$platform" --build-arg "VCS_REF=$revision" \
    --tag "$local_image_tag" "$project_root"; then
    record_result "local_docker_build" "PASSED" "No-cache $platform image built from the checkout" "logs/local_docker_build.log"
    if run_logged "local_docker_runtime" env DOCKER_CONFIG="$docker_config_path" \
      "$project_root/script/docker-smoke" --skip-build --tag "$local_image_tag" --platform "$platform"; then
      record_result "local_docker_runtime" "PASSED" "Default, JSON, doctor, test, benchmark, and offline checks passed" "logs/local_docker_runtime.log"
    else
      record_result "local_docker_runtime" "FAILED" "Local image failed runtime smoke" "logs/local_docker_runtime.log"
    fi
  else
    record_result "local_docker_build" "FAILED" "No-cache image build failed" "logs/local_docker_build.log"
    record_result "local_docker_runtime" "SKIPPED" "Image build failed" "logs/local_docker_build.log"
  fi
}

bundle_state=0
bundle_environment=()

ensure_isolated_bundle() {
  if [[ "$bundle_state" == 1 ]]; then
    return 0
  fi
  if [[ "$bundle_state" == -1 ]]; then
    return 1
  fi

  missing=""
  for prerequisite in ruby bundle rustc cargo make cc; do
    if ! command -v "$prerequisite" >/dev/null 2>&1; then
      missing="$missing $prerequisite"
    fi
  done

  if [[ -n "$missing" ]]; then
    bundle_state=-1
    bundle_failure_detail="Missing native prerequisites:$missing"
    return 1
  fi

  native_bundle_path="$output_path/native-bundle"
  bundle_environment=(
    "BUNDLE_GEMFILE=$project_root/Gemfile"
    "BUNDLE_IGNORE_CONFIG=1"
    "BUNDLE_FROZEN=true"
    "BUNDLE_PATH=$native_bundle_path"
  )

  if run_logged "isolated_bundle_install" env "${bundle_environment[@]}" bundle install --jobs 4 --retry 3; then
    bundle_state=1
    record_result "isolated_bundle_install" "PASSED" "Dependencies installed under the ignored evidence directory" "logs/isolated_bundle_install.log"
    return 0
  fi

  bundle_state=-1
  bundle_failure_detail="Isolated bundle install failed"
  record_result "isolated_bundle_install" "FAILED" "$bundle_failure_detail" "logs/isolated_bundle_install.log"
  return 1
}

run_native_checks() {
  if ! ensure_isolated_bundle; then
    if [[ "$bundle_failure_detail" == Missing* ]]; then
      record_result "native_source" "SKIPPED" "$bundle_failure_detail" "-"
    else
      record_result "native_source" "SKIPPED" "Dependency installation failed" "logs/isolated_bundle_install.log"
    fi
    return
  fi

  if run_logged "native_compile" env "${bundle_environment[@]}" bundle exec rake compile; then
    record_result "native_compile" "PASSED" "Native extension compiled" "logs/native_compile.log"
  else
    record_result "native_compile" "FAILED" "Native extension compile failed" "logs/native_compile.log"
    record_result "native_tests" "SKIPPED" "Compile failed" "logs/native_compile.log"
    record_result "native_demo" "SKIPPED" "Compile failed" "logs/native_compile.log"
    return
  fi

  if run_logged "native_tests" env "${bundle_environment[@]}" bundle exec rake test; then
    record_result "native_tests" "PASSED" "Ruby integration suite passed" "logs/native_tests.log"
  else
    record_result "native_tests" "FAILED" "Ruby integration suite failed" "logs/native_tests.log"
  fi

  if run_logged "native_demo" env "${bundle_environment[@]}" bundle exec ruby script/demo; then
    record_result "native_demo" "PASSED" "Deterministic 10-check demo passed" "logs/native_demo.log"
  else
    record_result "native_demo" "FAILED" "Deterministic demo failed" "logs/native_demo.log"
  fi
}

run_package_checks() {
  if ! ensure_isolated_bundle; then
    if [[ "$bundle_failure_detail" == Missing* ]]; then
      record_result "source_gem" "SKIPPED" "$bundle_failure_detail" "-"
    else
      record_result "source_gem" "SKIPPED" "Dependency installation failed" "logs/isolated_bundle_install.log"
    fi
    return
  fi

  if run_logged "source_gem" env "${bundle_environment[@]}" bundle exec rake package:audit; then
    record_result "source_gem" "PASSED" "Manifest audit, isolated gem install, safe require, and minimal contract passed" "logs/source_gem.log"
  else
    record_result "source_gem" "FAILED" "Source-gem isolated install verification failed" "logs/source_gem.log"
  fi
}

cd "$project_root"
case "$mode" in
  docker) run_docker_checks ;;
  native) run_native_checks ;;
  package) run_package_checks ;;
  all)
    run_docker_checks
    run_native_checks
    run_package_checks
    ;;
esac

{
  printf '\n## Totals\n\n'
  printf -- '- Passed: %s\n' "$passes"
  printf -- '- Skipped: %s\n' "$skips"
  printf -- '- Failed: %s\n' "$failures"
  printf -- '- Environment: `environment.txt`\n'
} >> "$summary_markdown"

printf '\nSummary: %s passed, %s skipped, %s failed\n' "$passes" "$skips" "$failures"
printf 'Evidence: %s\n' "$output_path"

if (( failures > 0 )); then
  exit 1
fi
