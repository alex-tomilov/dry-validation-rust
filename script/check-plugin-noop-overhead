#!/usr/bin/env ruby
# frozen_string_literal: true

require 'json'

MAXIMUM_RATIO = 1.01
BENCHMARKS = {
  # Criterion turns slash-separated benchmark IDs into directory-safe names.
  without: 'plugin_overhead_validate_without_plugin',
  noop: 'plugin_overhead_validate_with_noop_plugin'
}.freeze

abort "Usage: #{File.basename($PROGRAM_NAME)} CRITERION_DIRECTORY" unless ARGV.length == 1

def estimate(directory, benchmark)
  path = File.join(directory, benchmark, 'new', 'estimates.json')
  abort "Missing Criterion estimate for #{benchmark}: #{path}" unless File.file?(path)

  payload = JSON.parse(File.read(path))
  mean = payload.dig('mean', 'point_estimate')
  interval = payload.dig('mean', 'confidence_interval')
  confidence_level = interval&.fetch('confidence_level', nil)
  lower = interval&.fetch('lower_bound', nil)
  upper = interval&.fetch('upper_bound', nil)
  # Confidence level is fixed JSON metadata, not a computed measurement.
  valid_confidence = confidence_level == 0.95 # rubocop:disable Lint/FloatComparison
  unless [mean, lower, upper].all? { |value| value.is_a?(Numeric) && value.finite? && value.positive? } &&
         lower <= mean && mean <= upper && valid_confidence
    abort "Invalid 95% Criterion mean estimate for #{benchmark}"
  end

  { mean:, lower:, upper: }
end

directory = File.expand_path(ARGV.fetch(0))
without = estimate(directory, BENCHMARKS.fetch(:without))
noop = estimate(directory, BENCHMARKS.fetch(:noop))
overhead = noop.fetch(:mean).fdiv(without.fetch(:mean)) - 1

# Compare the most favorable endpoints before rejecting a regression. These are
# individual 95% mean intervals, not a joint 95% interval for the ratio.
if noop.fetch(:lower) > without.fetch(:upper) * MAXIMUM_RATIO
  abort format('NOOP plugin overhead exceeds 1%%: %<overhead>.2f%% (%<noop>.2f ns vs %<without>.2f ns)',
               overhead: overhead * 100, noop: noop.fetch(:mean), without: without.fetch(:mean))
end

if noop.fetch(:upper) <= without.fetch(:lower) * MAXIMUM_RATIO
  puts format('NOOP plugin path is within the 1%% limit: %.2f%% overhead', overhead * 100)
else
  # Inconclusive measurements do not fail CI or establish the performance claim.
  puts format('NOOP plugin overhead is inconclusive: %.2f%% overhead; mean confidence bounds span the 1%% limit. ' \
              'Rerun with longer sampling to resolve.', overhead * 100)
end
